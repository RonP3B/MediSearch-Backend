@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[ProductOutOfStockTemplateCodes.ProductOutOfStockTitle]">
    <h1>@T[ProductOutOfStockTemplateCodes.ProductOutOfStockTitle]</h1>

    <p>@T[ProductOutOfStockTemplateCodes.ProductOutOfStockIntro]</p>

    <div class="info-block">
        <div class="label">@T[SharedTemplateCodes.ProductLabel]</div>
        <div class="value">@Model.ProductName</div>
    </div>

    <p>@T[ProductOutOfStockTemplateCodes.ProductOutOfStockBody]</p>

    <div class="btn-center">
        <a href="@UrlBuilder.ClientLoginUrl" class="btn">@T[SharedTemplateCodes.OpenMediSearchButton]</a>
    </div>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required ProductOutOfStockModel Model { get; set; }
}
