@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[ProductDeletedTemplateCodes.ProductDeletedTitle]">
    <h1>@T[ProductDeletedTemplateCodes.ProductDeletedTitle]</h1>

    <p>@T[ProductDeletedTemplateCodes.ProductDeletedIntro]</p>

    <div class="info-block">
        <div class="label">@T[SharedTemplateCodes.ProductLabel]</div>
        <div class="value">@Model.ProductName</div>
    </div>

    <p>@T[ProductDeletedTemplateCodes.ProductDeletedBody]</p>

    <div class="btn-center">
        <a href="@UrlBuilder.ClientLoginUrl" class="btn">@T[SharedTemplateCodes.OpenMediSearchButton]</a>
    </div>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required ProductDeletedModel Model { get; set; }
}
