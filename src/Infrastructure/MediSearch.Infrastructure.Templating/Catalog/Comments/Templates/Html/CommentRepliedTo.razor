@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[CommentRepliedToTemplateCodes.CommentRepliedToTitle]">
    <h1>@T[CommentRepliedToTemplateCodes.CommentRepliedToTitle]</h1>

    <p>@T[CommentRepliedToTemplateCodes.CommentRepliedToIntro]</p>

    <div class="info-block">
        <div class="label">@T[CommentRepliedToTemplateCodes.CommentRepliedToAuthorLabel]</div>
        <div class="value">@Model.ReplyAuthorName</div>
    </div>

    <div class="info-block">
        <div class="label">@T[CommentRepliedToTemplateCodes.CommentRepliedToReplyLabel]</div>
        <div class="value">@Model.ReplyContent</div>
    </div>

    <p>@T[CommentRepliedToTemplateCodes.CommentRepliedToBody]</p>

    <div class="btn-center">
        <a href="@UrlBuilder.ClientLoginUrl" class="btn">@T[SharedTemplateCodes.OpenMediSearchButton]</a>
    </div>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public CommentRepliedToModel Model { get; set; } = default!;
}
