@inject ITextLocalizer T

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Title</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #f0f4f8;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            font-size: 15px;
            color: #1a202c;
            -webkit-text-size-adjust: 100%;
        }

            .capitalize-name {
                text-transform: capitalize;
            }

        .wrapper {
            width: 100%;
            padding: 40px 16px;
        }

        .card {
            max-width: 580px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        .card-header {
            background: #0f172a;
            padding: 28px 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header .brand {
                color: #ffffff;
                font-size: 18px;
                font-weight: 700;
                letter-spacing: -0.3px;
            }

                .card-header .brand span {
                    color: #38bdf8;
                }

        .card-body {
            padding: 36px 40px;
            line-height: 1.7;
            color: #374151;
        }

            .card-body h1 {
                font-size: 22px;
                font-weight: 700;
                color: #0f172a;
                margin: 0 0 20px;
                letter-spacing: -0.3px;
            }

            .card-body p {
                margin: 0 0 16px;
            }

        .info-block {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px 20px;
            margin: 24px 0;
        }

            .info-block .label {
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #94a3b8;
                margin-bottom: 4px;
            }

            .info-block .value {
                font-size: 15px;
                font-weight: 600;
                color: #0f172a;
            }

        .btn {
            display: inline-block;
            padding: 13px 28px;
            background: #2563eb;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.2px;
            transition: background .15s;
        }

        .btn-center {
            text-align: center;
            margin: 28px 0;
        }

        .divider {
            border: none;
            border-top: 1px solid #e5e7eb;
            margin: 24px 0;
        }

        .muted {
            font-size: 13px;
            color: #9ca3af;
        }

        .card-footer {
            background: #f8fafc;
            border-top: 1px solid #e5e7eb;
            padding: 20px 40px;
        }

            .card-footer p {
                margin: 0;
                font-size: 12px;
                color: #9ca3af;
                line-height: 1.6;
            }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="card">
            <div class="card-header">
                <span class="brand">Medi<span>Search</span></span>
            </div>
            <div class="card-body">
                @ChildContent
            </div>
            <div class="card-footer">
                <p>@T[SharedTemplateCodes.EmailFooterDisclaimer]</p>
            </div>
        </div>
    </div>
</body>
</html>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
