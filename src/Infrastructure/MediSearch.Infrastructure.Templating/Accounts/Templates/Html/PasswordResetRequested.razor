@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[PasswordResetRequestedTemplateCodes.PasswordResetTitle]">
    <h1>@T[PasswordResetRequestedTemplateCodes.PasswordResetTitle] 🔐</h1>

    <p>@T[SharedTemplateCodes.EmailGreeting], <span class="capitalize-name">@Model.FullName</span></p>

    <p>@T[PasswordResetRequestedTemplateCodes.PasswordResetIntro]</p>

    <div class="btn-center">
        <a 
            href="@UrlBuilder.BuildResetPasswordUrl(Model.ExternalUserId, Model.ResetToken)"
            class="btn"
        >@T[PasswordResetRequestedTemplateCodes.PasswordResetButton]</a>
    </div>

    <hr class="divider" />

    <p class="muted">@T[PasswordResetRequestedTemplateCodes.PasswordResetExpiryNote]</p>

    <hr class="divider" />

    <p class="muted">@T[SharedTemplateCodes.NotYouNotice]</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required PasswordResetRequestedModel Model { get; set; } 
}
