@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[ClientUserWelcomeTemplateCodes.ClientWelcomeTitle]">
    <h1>@T[SharedTemplateCodes.EmailGreeting], <span class="capitalize-name">@Model.FullName</span> 👋</h1>

    <p>@T[ClientUserWelcomeTemplateCodes.ClientWelcomeIntro]</p>

    <p>@T[ClientUserWelcomeTemplateCodes.ClientWelcomeBody]</p>

    <div class="btn-center">
        <a href="@UrlBuilder.ClientLoginUrl" class="btn">@T[SharedTemplateCodes.GoToMediSearchButton]</a>
    </div>

    <hr class="divider" />

    <p class="muted">@T[SharedTemplateCodes.NotYouNotice]</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required ClientUserWelcomeModel Model { get; set; } 
}
