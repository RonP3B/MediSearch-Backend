@inject ITextLocalizer T

<EmailLayout Title="@T[PasswordChangedTemplateCodes.PasswordChangedTitle]">
    <h1>@T[SharedTemplateCodes.EmailGreeting], <span class="capitalize-name">@Model.FullName</span> 👋</h1>

    <p>@T[PasswordChangedTemplateCodes.PasswordChangedBody]</p>

    <hr class="divider" />

    <p class="muted">@T[SharedTemplateCodes.NotYouNotice]</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required PasswordChangedModel Model { get; set; }
}
