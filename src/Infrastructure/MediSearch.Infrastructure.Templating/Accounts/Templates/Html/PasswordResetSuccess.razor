@inject ITextLocalizer T
@inject AppUrlBuilder UrlBuilder

<EmailLayout Title="@T[PasswordResetSuccessTemplateCodes.PasswordResetSuccessTitle]">
    <h1>@T[SharedTemplateCodes.EmailGreeting], <span class="capitalize-name">@Model.FullName</span> 👋</h1>

    <p>@T[PasswordResetSuccessTemplateCodes.PasswordResetSuccessBody]</p>

    <div class="btn-center">
        <a href="@UrlBuilder.ClientLoginUrl" class="btn">@T[PasswordResetSuccessTemplateCodes.PasswordResetSuccessCtaButton]</a>
    </div>

    <hr class="divider" />

    <p class="muted">@T[SharedTemplateCodes.NotYouNotice]</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired]
    public required PasswordResetSuccessModel Model { get; set; }
}
