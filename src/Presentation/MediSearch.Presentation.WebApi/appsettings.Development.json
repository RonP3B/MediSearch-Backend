{
  "AppUrls": {
    "ApiBaseUrl": "https://localhost:5001/api/v1",
    "AssetBaseUrl": "https://localhost:5001/uploads",
    "ClientBaseUrl": "http://localhost:3000"
  },
  "ConnectionStrings": {
    // These values are injected automatically by Aspire via environment variables at runtime.
    // They are only used as a fallback when running the WebApi directly without the AppHost
    "MediSearchDb": "Server=127.0.0.1;Port=5432;Database=MediSearchDb;Username=admin;Password=password;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
