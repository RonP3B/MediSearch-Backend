{
  "AppUrls": {
    "ApiBaseUrl": "https://localhost:5001/api/v1",
    "AssetBaseUrl": "https://localhost:5001/uploads",
    "ClientBaseUrl": "http://localhost:3000"
  },
  "ConnectionStrings": {
    // These values are injected automatically by Aspire via environment variables at runtime.
    // They are only used as a fallback when running the WebApi directly without the AppHost
    "MediSearchDb": "Server=127.0.0.1;Port=5432;Database=MediSearchDb;Username=admin;Password=password;",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Keycloak": {
    // Injected automatically by Aspire as the Keycloak__Url environment variable.
    // This value is only used when running the Web API directly without the AppHost.
    "Url": "http://localhost:8080",
    // Development-only secret. It must match the client secret declared in
    // src/Hosting/MediSearch.Hosting.AppHost/Realms/medisearch-realm.json.
    // Outside development this belongs in user secrets or Key Vault.
    "ClientSecret": "dev-only-medisearch-api-client-secret"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
